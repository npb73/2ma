{
  "name": "@2ma/shared",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "maps:gen": "node scripts/gen-map-catalog.mjs",
    "prebuild": "node scripts/gen-map-catalog.mjs",
    "build": "tsc && mkdir -p dist/maps && cp src/maps/*.json dist/maps/",
    "dev": "node scripts/gen-map-catalog.mjs --watch & tsc --watch"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
