# Server
PORT=2567
MONGO_URI=mongodb://127.0.0.1:27017/zuma
JWT_SECRET=dev-change-me-in-production
# Browser origin for CORS (Vite dev :5173, Docker client :8080)
CLIENT_ORIGIN=http://localhost:8080

# Yandex ID OAuth — leave empty to use DEV login bypass
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:2567/auth/yandex/callback

# When Yandex creds are empty, /auth/dev creates a test user
DEV_AUTH=true
